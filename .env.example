APP_NAME="Standee QR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Final domain (no trailing slash). QR codes are built from this. Never change after printing.
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=standee_qr
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Optional: shown in the contact section on the home page
BUSINESS_NAME=TapReach
BUSINESS_WHATSAPP=
BUSINESS_EMAIL=
